{
  "manifest_version": 3,
  "name": "포토 업로드 전 확인",
  "version": "0.2.0",
  "description": "Google 포토의 비교용 목록을 직접 연결하고 PC의 사진과 업로드 전에 대조합니다.",
  "permissions": ["scripting"],
  "host_permissions": ["https://photos.google.com/*"],
  "background": { "service_worker": "photo-check/background.js" },
  "action": { "default_title": "포토 업로드 전 확인 열기" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
